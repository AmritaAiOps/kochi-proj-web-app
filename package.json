{
  "name": "daily-his-report-automation",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "setup": "npm install && npm install --prefix frontend",
    "build": "npm run build --prefix frontend",
    "dev": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "test": "npm test --prefix frontend"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  },
  "allowScripts": {
    "workerd": true,
    "esbuild": true
  }
}
